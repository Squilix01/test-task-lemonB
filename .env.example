# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_HOST=postgres
DB_PORT=5432

# Redis Broker & Cache
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET_KEY=super-secret-key-change-me-in-production-random-salt-12345
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Initial Admin Credentials (Auto-created on first startup)
SEED_USERNAME=admin
SEED_PASSWORD=admin

# Optional: LLM Configuration for AI Scoring
# Supported providers: gemini, openai
# If not configured, deterministic fallback mathematical formula is automatically used
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy...
# LLM_MODEL=gemini-1.5-flash
